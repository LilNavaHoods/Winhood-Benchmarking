{
  "name": "winhood-benchmarking",
  "private": true,
  "version": "4.4.0",
  "type": "module",
  "bin": {
    "winhood": "./cli/winhood-cli.ts"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "cli": "tsx cli/winhood-cli.ts",
    "build": "vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "tsx electron-main.ts",
    "pack:win": "npm run build:desktop && electron-builder --config electron-builder.json --dir",
    "dist:win": "npm run build:desktop && electron-builder --config electron-builder.json --win nsis portable",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-desktop server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/engine/analyzer.test.ts src/analyzers/analyzers.test.ts src/analyzers/pluginsAndIac.test.ts src/gate/gateAndCompliance.test.ts src/cli/cliAndApi.test.ts src/intelligence/intelligence.test.ts src/security/security.test.ts src/integrations/mqr-bridge/mqrMethodology.test.ts src/desktop/desktop.test.ts",
    "test:coverage": "node scripts/run-coverage-gate.mjs",
    "test:unit": "tsx --test src/engine/analyzer.test.ts src/analyzers/analyzers.test.ts src/analyzers/pluginsAndIac.test.ts src/gate/gateAndCompliance.test.ts src/cli/cliAndApi.test.ts src/intelligence/intelligence.test.ts src/integrations/mqr-bridge/mqrMethodology.test.ts",
    "test:security": "tsx --test src/security/security.test.ts",
    "test:mqr": "tsx --test src/integrations/mqr-bridge/mqrMethodology.test.ts",
    "test:desktop": "tsx --test src/desktop/desktop.test.ts",
    "test:golden": "tsx --test src/intelligence/intelligence.test.ts"
  },
  "c8": {
    "check-coverage": true,
    "lines": 80,
    "functions": 80,
    "branches": 75,
    "reporter": ["text", "html", "json-summary"],
    "report-dir": "coverage",
    "thresholds": {
      "lines": 80,
      "functions": 80,
      "branches": 75,
      "src/scoring/**": {
        "lines": 95,
        "functions": 95,
        "branches": 95
      },
      "src/evidence/**": {
        "lines": 95,
        "functions": 95,
        "branches": 95
      },
      "src/comparability/**": {
        "lines": 95,
        "functions": 95,
        "branches": 95
      }
    }
  },
  "nyc": {
    "check-coverage": true,
    "lines": 80,
    "functions": 80,
    "branches": 75,
    "reporter": ["text", "html", "json-summary"],
    "report-dir": "coverage"
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
