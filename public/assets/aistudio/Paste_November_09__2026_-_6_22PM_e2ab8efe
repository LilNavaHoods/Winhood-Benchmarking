    db,
    'VULNERABILITY_VALIDATION_UPDATED',
    'FINDING',
    finding.id,
    `Achado ${finding.id} classificado como ${validationState} com evidência SHA-256 ${newEvHash.slice(0, 12)}.`
  );
  saveDatabase(db);
  return res.json({ ok: true, finding, evidenceHash: newEvHash });
});

