# WinHood Benchmarking — Variáveis de Ambiente (Sem segredos)
# Copie este arquivo para .env apenas em ambiente local e nunca comite credenciais reais.
# SEGURANÇA: Nunca exponha chaves ou tokens privados em variáveis VITE_* ou no frontend.
#
# Acesso Local Livre + TOTP 2FA Opcional:
# O WinHood opera localmente com acesso total irrestrito sem cadastro, login, senha ou OAuth.
# A proteção opcional TOTP 2FA (RFC-6238) pode ser ativada/desativada diretamente pela interface.

# Ambiente de execução (development | production)
NODE_ENV=development
PORT=3000

# Origens CORS adicionais permitidas (separadas por vírgula, opcional)
WINHOOD_ALLOWED_ORIGINS=

# Defina como true apenas quando o WinHood estiver atrás de um reverse proxy HTTPS confiável
WINHOOD_TRUST_PROXY=false

# Keystore / Criptografia em repouso (obrigatório em produção sem DPAPI/Keychain nativo):
# Gere um segredo aleatório de alta entropia (>= 32 bytes) no cofre do servidor/orquestrador.
WINHOOD_KEYSTORE_MASTER_SECRET=
