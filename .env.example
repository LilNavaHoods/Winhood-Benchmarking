# WinHood Benchmarking — Variáveis de Ambiente (Sem segredos)
# Copie este arquivo para .env apenas em ambiente local e nunca comite credenciais reais.
# SEGURANÇA: Nunca exponha Client Secret, tokens ou chaves mestras em variáveis VITE_* ou no frontend.

# Ambiente de execução (development | production)
# Em production, exige HTTPS no callback OAuth, cookies Secure e keystore seguro.
NODE_ENV=development
PORT=3000

# GitHub OAuth 2.0 (Authorization Code + PKCE S256) — Configuração única pelo administrador
# Crie um OAuth App em: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#
# Desenvolvimento local:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/github/oauth/callback
#
# Produção / Cloud (HTTPS obrigatório):
#   Homepage URL:               https://<seu-dominio>
#   Authorization callback URL: https://<seu-dominio>/api/auth/github/oauth/callback
#   Defina WINHOOD_GITHUB_OAUTH_CALLBACK_URL ou APP_URL para corresponder exatamente à URL registrada.
#
# Instalação Desktop (Electron — servidor local loopback):
#   Homepage URL:               http://127.0.0.1:3000 (ou http://localhost:3000 quando porta fixa)
#   Authorization callback URL: http://127.0.0.1:3000/api/auth/github/oauth/callback
#   Observação: no Desktop, o fluxo pode ser configurado uma única vez via Painel Admin OAuth
#   (armazenado criptografado com AES-256-GCM / DPAPI no cofre do servidor) ou via variáveis abaixo.
#
# Usuários finais nunca precisam informar PAT, senha GitHub, Client ID ou Client Secret.
WINHOOD_GITHUB_OAUTH_CLIENT_ID=
WINHOOD_GITHUB_OAUTH_CLIENT_SECRET=
WINHOOD_GITHUB_OAUTH_CALLBACK_URL=

# URL pública base da aplicação (opcional, usada como fallback seguro para callback OAuth em produção):
APP_URL=

# Defina como false para bloquear cadastro automático de novos usuários via GitHub (apenas contas existentes):
WINHOOD_GITHUB_ALLOW_SIGNUP=true

# Defina como true apenas quando o WinHood estiver atrás de um reverse proxy HTTPS confiável (ex.: Nginx, Cloud Run, ALB):
WINHOOD_TRUST_PROXY=false

# Keystore / Criptografia em repouso (obrigatório em produção sem DPAPI/KMS nativo):
# Gere um segredo aleatório de alta entropia (>= 32 bytes) no cofre do servidor/orquestrador.
WINHOOD_KEYSTORE_MASTER_SECRET=
