# syntax=docker/dockerfile:1.7

# ==============================================================================
# WinHood Isolated Scanner Worker — Container Dedicado para Analisadores Externos
# Execução não-root, versões fixadas (sem tags mutáveis), sem acesso a docker.sock
# ==============================================================================
FROM node:22.14.0-bookworm-slim AS worker-builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json server.ts ./
COPY scripts/build-server.mjs ./scripts/build-server.mjs
COPY src ./src

RUN npm run build:server \
  && test -s dist-server/scanner-worker.mjs

FROM node:22.14.0-bookworm-slim AS worker-runtime

ARG RUFF_VERSION=0.9.6
ARG BANDIT_VERSION=1.8.3
ARG SEMGREP_VERSION=1.109.0
ARG GITLEAKS_VERSION=8.24.0
ARG OSV_SCANNER_VERSION=1.9.2
ARG SYFT_VERSION=1.20.0
ARG GRYPE_VERSION=0.89.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       python3 \
       python3-venv \
       tar \
       gzip \
  && rm -rf /var/lib/apt/lists/* \
  && python3 -m venv /opt/winhood-pytools \
  && /opt/winhood-pytools/bin/pip install --no-cache-dir \
       "ruff==${RUFF_VERSION}" \
       "bandit==${BANDIT_VERSION}" \
       "semgrep==${SEMGREP_VERSION}" \
  && ARCH="$(dpkg --print-architecture)" \
  && case "${ARCH}" in \
       amd64) BIN_ARCH="x64"; GO_ARCH="amd64" ;; \
       arm64) BIN_ARCH="arm64"; GO_ARCH="arm64" ;; \
       *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
     esac \
  && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${BIN_ARCH}.tar.gz" \
     | tar -xz -C /usr/local/bin gitleaks \
  && curl -fsSL -o /usr/local/bin/osv-scanner \
     "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_${GO_ARCH}" \
  && chmod 755 /usr/local/bin/gitleaks /usr/local/bin/osv-scanner \
  && curl -fsSL "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_${GO_ARCH}.tar.gz" \
     | tar -xz -C /usr/local/bin syft \
  && curl -fsSL "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_${GO_ARCH}.tar.gz" \
     | tar -xz -C /usr/local/bin grype \
  && chmod 755 /usr/local/bin/syft /usr/local/bin/grype \
  && groupadd --gid 1001 winhood \
  && useradd --uid 1001 --gid 1001 --create-home --shell /usr/sbin/nologin winhood \
  && mkdir -p /tmp/winhood-workspaces /app \
  && chown -R winhood:winhood /tmp/winhood-workspaces /app \
  && chmod 700 /tmp/winhood-workspaces

WORKDIR /app

COPY --from=worker-builder --chown=winhood:winhood /app/dist-server/scanner-worker.mjs ./dist-server/scanner-worker.mjs
COPY --chown=winhood:winhood package.json LICENSE SECURITY.md ./

ENV NODE_ENV=production \
    PATH="/opt/winhood-pytools/bin:/usr/local/bin:/usr/bin:/bin" \
    WINHOOD_SCANNER_WORKER_HOST=0.0.0.0 \
    WINHOOD_SCANNER_WORKER_PORT=4100 \
    WINHOOD_TEMP_WORKSPACE_DIR=/tmp/winhood-workspaces \
    WINHOOD_SCANNER_WORKER_IMAGE="winhood-scanner-worker:4.4.0"

USER winhood

EXPOSE 4100

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.WINHOOD_SCANNER_WORKER_PORT || 4100) + '/worker/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "dist-server/scanner-worker.mjs"]
